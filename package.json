{
  "name": "astro-module",
  "version": "0.1.0",
  "description": "Module migrations, permissions, and Astro page/API scaffold for Astro projects",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "astro-module": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "astro",
    "migration",
    "permissions",
    "scaffold",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neerajkumarSenior/astro-module.git"
  },
  "bugs": {
    "url": "https://github.com/neerajkumarSenior/astro-module/issues"
  },
  "homepage": "https://github.com/neerajkumarSenior/astro-module#readme"
}
